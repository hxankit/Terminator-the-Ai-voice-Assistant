# Copy to backend/.env and adjust. Never commit the real .env.

APP_ENV=development              # "production" enforces JWT_SECRET + SECRET_KEY and secure cookies
MONGO_URI=mongodb://localhost:27017
MONGO_DB=terminator

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts provider API keys at rest. Keep it stable: changing it makes stored keys unreadable.
SECRET_KEY=

JWT_TTL_MINUTES=1440
CORS_ORIGINS=http://localhost:5173   # comma-separated; the Vite dev server in development
DATA_DIR=data                        # uploads, generated files, dev key
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
ALLOW_REGISTRATION=true              # set false after creating your account

# Optional default LLM provider for every user (users can add their own in Settings → Models).
# Ollama example:
DEFAULT_PROVIDER_BASE_URL=           # http://localhost:11434/v1
DEFAULT_PROVIDER_API_KEY=
DEFAULT_MODEL=                       # llama3.1:8b
DEFAULT_EMBEDDING_MODEL=             # nomic-embed-text

# Web search for the Research agent: set ONE of these.
SEARXNG_URL=                         # self-hosted SearxNG with JSON output enabled
TAVILY_API_KEY=

# Host commands the SysAdmin agent may run (each run still needs your approval in the UI).
SYSTEM_COMMAND_ALLOWLIST=uptime,df,free,ps,uname,whoami,pm2,systemctl,journalctl,nginx,docker,ss,ls,cat,tail,head
SANDBOX_TIMEOUT_S=20
REMINDER_INTERVAL_S=5

# Desktop control (open apps, volume, media, WhatsApp prefill, terminal commands with approval).
# Turns itself off when there is no graphical session (e.g. on a VPS).
DESKTOP_CONTROL=true
SHELL_TIMEOUT_S=60

# Keep local models (Ollama) loaded and their prompt cache warm for this long after last use (0 = off).
# Avoids multi-minute "cold" replies on CPU-only machines; costs RAM while warm.
KEEP_WARM_HOURS=8
KEEP_WARM_INTERVAL_S=240

# Snapshot open browser tabs, VS Code projects, terminals and apps every N minutes so
# "open previous environment" works even after a normal shutdown (0 = off). Stored locally only.
ENV_AUTOSAVE_MINUTES=10
